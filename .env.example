# Copy to .env and adjust values.

# Keycloak bootstrap admin (admin console: https://keycloak.auth.example.test/admin)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Secret used by oauth2-proxy to encrypt its session cookie.
# oauth2-proxy expects URL-safe base64 (uses '-'/'_' instead of '+'/'/').
# Generate with:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
OAUTH2_PROXY_COOKIE_SECRET=change-me
